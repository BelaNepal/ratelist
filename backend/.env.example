# Enterprise Environment Template - Bela Rate & Costing Manager Backend

NODE_ENV=development
PORT=5000
API_PREFIX=/api
CORS_ORIGIN=http://localhost:5173

# Live Bela EcoPanels API Endpoint
LIVE_BELA_API_URL=https://belaecopanels.com/api/products

# PostgreSQL Enterprise Database Credentials
DB_CLIENT=pg
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_secure_password
PGDATABASE=bela_rate_db
DATABASE_URL=postgresql://postgres:your_secure_password@localhost:5432/bela_rate_db

# Security
JWT_SECRET=your_jwt_secret_key_here
RATE_LOCK_ENFORCED=true
